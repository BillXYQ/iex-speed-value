# --- Market data (raw data lives on OneDrive, never in git) ---
*.pcap
*.pcap.gz
data/raw/

# Everything under data/ except the small committed samples
data/*
!data/sample/
!data/sample/**

# Large derived data formats outside data/sample/
# (git cannot filter by size; the pre-commit hook in .githooks/ rejects files > 50MB)
*.parquet
*.feather
*.h5
*.hdf5
*.gz
*.zst
!data/sample/**/*.parquet
!data/sample/**/*.gz

# --- Local config (machine-specific paths) ---
config/config.local.yaml
.env
.env.*

# --- Python / Jupyter ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# --- OS / editors ---
.DS_Store
.vscode/
.idea/
